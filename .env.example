# Cấu hình SMTP gửi Email tự động trong WordPress
# Copy file này thành .env hoặc khai báo các hằng số này trong wp-config.php

WP_SMTP_HOST=smtp.gmail.com
WP_SMTP_PORT=587
WP_SMTP_USER=your-email@gmail.com
WP_SMTP_PASS=your-app-password
WP_SMTP_SECURE=tls
WP_SMTP_FROM=your-email@gmail.com
WP_SMTP_NAME=Vasco Electronics
